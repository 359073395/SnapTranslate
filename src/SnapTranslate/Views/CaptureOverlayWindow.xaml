<Window x:Class="SnapTranslate.Views.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="选择截图区域"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        Cursor="Cross"
        Background="Black"
        PreviewKeyDown="Window_KeyDown"
        PreviewMouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewMouseMove="Window_MouseMove"
        PreviewMouseLeftButtonUp="Window_MouseLeftButtonUp"
        PreviewMouseRightButtonDown="Window_MouseRightButtonDown">
    <Window.Resources>
        <Style x:Key="QuickToolButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="#303846" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="#3B4658" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarSeparatorStyle" TargetType="Separator">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Background" Value="#3D424B" />
        </Style>

        <Style x:Key="ResultCopyButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D7DEE9" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" ClipToBounds="True">
        <Image x:Name="ScreenshotImage" Stretch="Fill" />

        <Canvas x:Name="MaskCanvas" IsHitTestVisible="False">
            <Rectangle x:Name="TopShade" Fill="#A6000000" />
            <Rectangle x:Name="BottomShade" Fill="#A6000000" />
            <Rectangle x:Name="LeftShade" Fill="#A6000000" />
            <Rectangle x:Name="RightShade" Fill="#A6000000" />
        </Canvas>

        <Canvas x:Name="CaptureCanvas">
            <Grid x:Name="SelectionContent"
                  Visibility="Collapsed"
                  ClipToBounds="True"
                  IsHitTestVisible="False">
                <Image x:Name="SelectionImage"
                       Stretch="Fill"
                       SnapsToDevicePixels="True" />
                <Canvas x:Name="TranslationCanvas"
                        IsHitTestVisible="False" />
                <Canvas x:Name="AnnotationCanvas"
                        IsHitTestVisible="False" />
            </Grid>

            <Rectangle x:Name="SelectionBorder"
                       Stroke="#4F7CFF"
                       StrokeThickness="2"
                       StrokeDashArray="3,2"
                       Fill="Transparent"
                       IsHitTestVisible="False"
                       Visibility="Collapsed" />

            <Border x:Name="SizeBadge"
                    Padding="7,3"
                    Background="#EC171B23"
                    BorderBrush="#445064"
                    BorderThickness="1"
                    CornerRadius="4"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <TextBlock x:Name="SizeText"
                           Foreground="White"
                           FontSize="12" />
            </Border>

            <Canvas x:Name="HandleCanvas"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <Border x:Name="TopLeftHandle"
                        Width="9"
                        Height="9"
                        Background="#F8FAFC"
                        BorderBrush="#4F7CFF"
                        BorderThickness="2"
                        CornerRadius="2" />
                <Border x:Name="TopCenterHandle"
                        Width="9"
                        Height="9"
                        Background="#F8FAFC"
                        BorderBrush="#4F7CFF"
                        BorderThickness="2"
                        CornerRadius="2" />
                <Border x:Name="TopRightHandle"
                        Width="9"
                        Height="9"
                        Background="#F8FAFC"
                        BorderBrush="#4F7CFF"
                        BorderThickness="2"
                        CornerRadius="2" />
                <Border x:Name="MiddleLeftHandle"
                        Width="9"
                        Height="9"
                        Background="#F8FAFC"
                        BorderBrush="#4F7CFF"
                        BorderThickness="2"
                        CornerRadius="2" />
                <Border x:Name="MiddleRightHandle"
                        Width="9"
                        Height="9"
                        Background="#F8FAFC"
                        BorderBrush="#4F7CFF"
                        BorderThickness="2"
                        CornerRadius="2" />
                <Border x:Name="BottomLeftHandle"
                        Width="9"
                        Height="9"
                        Background="#F8FAFC"
                        BorderBrush="#4F7CFF"
                        BorderThickness="2"
                        CornerRadius="2" />
                <Border x:Name="BottomCenterHandle"
                        Width="9"
                        Height="9"
                        Background="#F8FAFC"
                        BorderBrush="#4F7CFF"
                        BorderThickness="2"
                        CornerRadius="2" />
                <Border x:Name="BottomRightHandle"
                        Width="9"
                        Height="9"
                        Background="#F8FAFC"
                        BorderBrush="#4F7CFF"
                        BorderThickness="2"
                        CornerRadius="2" />
            </Canvas>

            <Border x:Name="QuickToolbar"
                    Padding="10,6"
                    Background="#F21B1B1D"
                    BorderBrush="#343840"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18"
                                      ShadowDepth="4"
                                      Opacity="0.42" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SelectionToolButton"
                            Style="{StaticResource QuickToolButtonStyle}"
                            Click="SelectionToolButton_Click"
                            ToolTip="重新选择截图区域"
                            AutomationProperties.Name="选择区域">
                        <iconPacks:PackIconMaterial Width="24"
                                                   Height="24"
                                                   Kind="SelectionDrag" />
                    </Button>
                    <Button x:Name="RectangleToolButton"
                            Style="{StaticResource QuickToolButtonStyle}"
                            Click="RectangleToolButton_Click"
                            ToolTip="画矩形"
                            AutomationProperties.Name="矩形">
                        <iconPacks:PackIconMaterial Width="24"
                                                   Height="24"
                                                   Kind="RectangleOutline" />
                    </Button>
                    <Button x:Name="EllipseToolButton"
                            Style="{StaticResource QuickToolButtonStyle}"
                            Click="EllipseToolButton_Click"
                            ToolTip="画圆形或椭圆"
                            AutomationProperties.Name="圆形">
                        <iconPacks:PackIconMaterial Width="24"
                                                   Height="24"
                                                   Kind="CircleOutline" />
                    </Button>
                    <Button x:Name="ArrowToolButton"
                            Style="{StaticResource QuickToolButtonStyle}"
                            Click="ArrowToolButton_Click"
                            ToolTip="画箭头"
                            AutomationProperties.Name="箭头">
                        <iconPacks:PackIconMaterial Width="24"
                                                   Height="24"
                                                   Kind="ArrowTopRight" />
                    </Button>
                    <Button x:Name="PenToolButton"
                            Style="{StaticResource QuickToolButtonStyle}"
                            Click="PenToolButton_Click"
                            ToolTip="自由画笔"
                            AutomationProperties.Name="画笔">
                        <iconPacks:PackIconMaterial Width="24"
                                                   Height="24"
                                                   Kind="Draw" />
                    </Button>
                    <Button x:Name="MosaicToolButton"
                            Style="{StaticResource QuickToolButtonStyle}"
                            Click="MosaicToolButton_Click"
                            ToolTip="涂抹马赛克"
                            AutomationProperties.Name="马赛克">
                        <iconPacks:PackIconMaterial Width="24"
                                                   Height="24"
                                                   Kind="Checkerboard" />
                    </Button>
                    <Button x:Name="TextToolButton"
                            Style="{StaticResource QuickToolButtonStyle}"
                            Click="TextToolButton_Click"
                            ToolTip="添加文字"
                            AutomationProperties.Name="文字">
                        <iconPacks:PackIconMaterial Width="24"
                                                   Height="24"
                                                   Kind="FormatText" />
                    </Button>
                    <Button x:Name="ColorToolButton"
                            Style="{StaticResource QuickToolButtonStyle}"
                            Click="ColorToolButton_Click"
                            ToolTip="标注颜色"
                            AutomationProperties.Name="颜色">
                        <iconPacks:PackIconMaterial Width="24"
                                                   Height="24"
                                                   Kind="PaletteOutline"
                                                   Foreground="#FF4D4F" />
                    </Button>
                    <Button x:Name="ThicknessToolButton"
                            Style="{StaticResource QuickToolButtonStyle}"
                            Click="ThicknessToolButton_Click"
                            ToolTip="线条粗细"
                            AutomationProperties.Name="粗细">
                        <iconPacks:PackIconMaterial Width="24"
                                                   Height="24"
                                                   Kind="FormatLineWeight" />
                    </Button>
                    <Separator Style="{StaticResource ToolbarSeparatorStyle}" />
                    <Button x:Name="OcrButton"
                            Style="{StaticResource QuickToolButtonStyle}"
                            Click="OcrButton_Click"
                            ToolTip="识别图片中的文字"
                            AutomationProperties.Name="识别文字">
                        <iconPacks:PackIconMaterial Width="24"
                                                   Height="24"
                                                   Kind="TextRecognition" />
                    </Button>
                    <Button x:Name="TranslateButton"
                            Style="{StaticResource QuickToolButtonStyle}"
                            Click="TranslateButton_Click"
                            ToolTip="识别并翻译到图片"
                            AutomationProperties.Name="翻译为目标语言">
                        <iconPacks:PackIconMaterial Width="24"
                                                   Height="24"
                                                   Kind="Translate" />
                    </Button>
                    <Separator Style="{StaticResource ToolbarSeparatorStyle}" />
                    <Button x:Name="UndoButton"
                            Style="{StaticResource QuickToolButtonStyle}"
                            Click="UndoButton_Click"
                            ToolTip="撤销上一条标注"
                            AutomationProperties.Name="撤销">
                        <iconPacks:PackIconMaterial Width="24"
                                                   Height="24"
                                                   Kind="Undo" />
                    </Button>
                    <Button x:Name="SaveImageButton"
                            Style="{StaticResource QuickToolButtonStyle}"
                            Click="SaveImageButton_Click"
                            ToolTip="保存为 PNG"
                            AutomationProperties.Name="保存 PNG">
                        <iconPacks:PackIconMaterial Width="24"
                                                   Height="24"
                                                   Kind="DownloadOutline" />
                    </Button>
                    <Button x:Name="AdvancedEditorButton"
                            Style="{StaticResource QuickToolButtonStyle}"
                            Click="AdvancedEditorButton_Click"
                            ToolTip="在高级编辑器中继续"
                            AutomationProperties.Name="高级编辑">
                        <iconPacks:PackIconMaterial Width="24"
                                                   Height="24"
                                                   Kind="OpenInNew" />
                    </Button>
                    <Separator Style="{StaticResource ToolbarSeparatorStyle}" />
                    <Button Style="{StaticResource QuickToolButtonStyle}"
                            Click="CancelButton_Click"
                            ToolTip="取消截图（Esc）"
                            AutomationProperties.Name="取消截图">
                        <iconPacks:PackIconMaterial Width="26"
                                                   Height="26"
                                                   Foreground="#FF4D5A"
                                                   Kind="Close" />
                    </Button>
                    <Button x:Name="CompleteButton"
                            Style="{StaticResource QuickToolButtonStyle}"
                            Click="CompleteButton_Click"
                            ToolTip="完成并复制到剪贴板（Enter / 双击）"
                            AutomationProperties.Name="完成并复制到剪贴板">
                        <iconPacks:PackIconMaterial Width="28"
                                                   Height="28"
                                                   Foreground="#18C982"
                                                   Kind="Check" />
                    </Button>
                </StackPanel>
            </Border>

            <Border x:Name="ToolOptionsPanel"
                    Padding="12,9"
                    Background="#F21B2029"
                    BorderBrush="#435064"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed">
                <Grid>
                    <StackPanel x:Name="ColorOptions" Orientation="Horizontal">
                    <Button Width="28"
                            Height="28"
                            Margin="2"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="RedColorButton_Click"
                            ToolTip="红色">
                        <Ellipse Width="18" Height="18" Fill="#FF4D4F" />
                    </Button>
                    <Button Width="28"
                            Height="28"
                            Margin="2"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="YellowColorButton_Click"
                            ToolTip="黄色">
                        <Ellipse Width="18" Height="18" Fill="#FFD43B" />
                    </Button>
                    <Button Width="28"
                            Height="28"
                            Margin="2"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="GreenColorButton_Click"
                            ToolTip="绿色">
                        <Ellipse Width="18" Height="18" Fill="#2ECC71" />
                    </Button>
                    <Button Width="28"
                            Height="28"
                            Margin="2"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="BlueColorButton_Click"
                            ToolTip="蓝色">
                        <Ellipse Width="18" Height="18" Fill="#4F7CFF" />
                    </Button>
                    <Button Width="28"
                            Height="28"
                            Margin="2"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="WhiteColorButton_Click"
                            ToolTip="白色">
                        <Ellipse Width="18"
                                 Height="18"
                                 Fill="White"
                                 Stroke="#748094"
                                 StrokeThickness="1" />
                    </Button>
                    </StackPanel>
                    <StackPanel x:Name="ThicknessOptions"
                                Orientation="Horizontal"
                                Visibility="Collapsed">
                        <Button Width="42"
                                Margin="2"
                                Click="ThinButton_Click"
                                Content="2 px" />
                        <Button Width="42"
                                Margin="2"
                                Click="NormalButton_Click"
                                Content="4 px" />
                        <Button Width="42"
                                Margin="2"
                                Click="BoldButton_Click"
                                Content="6 px" />
                        <Button Width="48"
                                Margin="2"
                                Click="HeavyButton_Click"
                                Content="10 px" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="ResultsPopover"
                    Width="390"
                    Padding="14"
                    Background="#F21B2029"
                    BorderBrush="#435064"
                    BorderThickness="1"
                    CornerRadius="9"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18"
                                      ShadowDepth="4"
                                      Opacity="0.4" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#D7DEE9"
                                   Text="识别文字" />
                        <Button Grid.Column="1"
                                Style="{StaticResource ResultCopyButtonStyle}"
                                Click="CopyOriginalTextButton_Click"
                                Content="复制原文" />
                    </Grid>
                    <Border Grid.Row="1"
                            MinHeight="54"
                            MaxHeight="108"
                            Margin="0,7,0,10"
                            Padding="10,8"
                            Background="#11151C"
                            BorderBrush="#394354"
                            BorderThickness="1"
                            CornerRadius="5">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="OriginalTextBlock"
                                       Foreground="#F8FAFC"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#D7DEE9"
                                   Text="翻译结果（印尼语）" />
                        <Button Grid.Column="1"
                                Style="{StaticResource ResultCopyButtonStyle}"
                                Click="CopyTranslatedTextButton_Click"
                                Content="复制译文" />
                    </Grid>
                    <Border Grid.Row="3"
                            MinHeight="54"
                            MaxHeight="108"
                            Margin="0,7,0,0"
                            Padding="10,8"
                            Background="#11151C"
                            BorderBrush="#394354"
                            BorderThickness="1"
                            CornerRadius="5">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TranslatedTextBlock"
                                       Foreground="#68A3FF"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="StatusToast"
                    Padding="11,7"
                    Background="#EC171B23"
                    BorderBrush="#435064"
                    BorderThickness="1"
                    CornerRadius="6"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial x:Name="StatusIcon"
                                               Width="17"
                                               Height="17"
                                               Margin="0,0,7,0"
                                               VerticalAlignment="Center"
                                               Kind="CheckCircleOutline"
                                               Foreground="#72D584" />
                    <TextBlock x:Name="StatusText"
                               VerticalAlignment="Center"
                               Foreground="#F8FAFC"
                               Text="已复制到剪贴板" />
                </StackPanel>
            </Border>
        </Canvas>

        <Border x:Name="InitialHint"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,22,0,0"
                Padding="14,8"
                Background="#E61A1D24"
                BorderBrush="#435064"
                BorderThickness="1"
                CornerRadius="6"
                IsHitTestVisible="False">
            <TextBlock Foreground="White"
                       Text="拖动选择区域 · Esc 取消 · Enter / 双击完成并复制" />
        </Border>
    </Grid>
</Window>
