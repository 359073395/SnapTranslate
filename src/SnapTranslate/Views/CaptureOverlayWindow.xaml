<Window x:Class="SnapTranslate.Views.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择截图区域"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        Cursor="Cross"
        Background="Black"
        KeyDown="Window_KeyDown"
        PreviewMouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewMouseMove="Window_MouseMove"
        PreviewMouseLeftButtonUp="Window_MouseLeftButtonUp"
        PreviewMouseRightButtonDown="Window_MouseRightButtonDown">
    <Grid x:Name="RootGrid" ClipToBounds="True">
        <Image x:Name="ScreenshotImage" Stretch="Fill" />

        <Canvas IsHitTestVisible="False">
            <Rectangle x:Name="TopShade" Fill="#99000000" />
            <Rectangle x:Name="BottomShade" Fill="#99000000" />
            <Rectangle x:Name="LeftShade" Fill="#99000000" />
            <Rectangle x:Name="RightShade" Fill="#99000000" />
            <Rectangle x:Name="SelectionBorder"
                       Stroke="#4F7CFF"
                       StrokeThickness="2"
                       Fill="Transparent"
                       Visibility="Collapsed" />
            <Border x:Name="SizeBadge"
                    Padding="7,3"
                    Background="#E61A1D24"
                    CornerRadius="4"
                    Visibility="Collapsed">
                <TextBlock x:Name="SizeText"
                           Foreground="White"
                           FontSize="12" />
            </Border>
        </Canvas>

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,22,0,0"
                Padding="14,8"
                Background="#D91A1D24"
                CornerRadius="6"
                IsHitTestVisible="False">
            <TextBlock Foreground="White"
                       Text="拖动选择区域 · 右键或 Esc 取消" />
        </Border>
    </Grid>
</Window>
