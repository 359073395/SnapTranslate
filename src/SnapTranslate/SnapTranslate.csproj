<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\lingxi-icon.ico</ApplicationIcon>
    <AssemblyName>LingxiCapture</AssemblyName>
    <RootNamespace>SnapTranslate</RootNamespace>
    <Version>0.3.0</Version>
    <AssemblyTitle>灵犀截图</AssemblyTitle>
    <Product>灵犀截图</Product>
    <Authors>Lingxi Capture contributors</Authors>
    <Description>灵犀截图：Windows 截图、标注、OCR 与洞察式翻译工具。</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MahApps.Metro.IconPacks.Material" Version="6.2.1" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Assets\lingxi-icon.ico" />
    <None Remove="Assets\lingxi-icon.png" />
    <Resource Include="Assets\lingxi-icon.ico" />
    <Resource Include="Assets\lingxi-icon.png" />
  </ItemGroup>
</Project>
