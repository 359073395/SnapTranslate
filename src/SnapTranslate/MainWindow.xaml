<Window x:Class="SnapTranslate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="灵犀截图"
        Icon="Assets/lingxi-icon.ico"
        Height="820"
        Width="760"
        MinHeight="680"
        MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        Foreground="White"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="34">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="68" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Width="56"
                       Height="56"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Source="Assets/lingxi-icon.png"
                       Stretch="Uniform" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="灵犀截图"
                               FontSize="32"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#AFC0FF"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Text="LINGUAL INSIGHT · TRANSLATE WITH INSIGHT" />
                    <TextBlock Margin="0,7,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="14"
                               Text="翻译不止于字面，截图、洞察与表达一步完成。" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,28,0,0"
                    Padding="22"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="截图快捷键"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="点击输入框，再按新的组合键；按 Esc 取消。" />
                        <TextBox x:Name="HotkeyTextBox"
                                 Width="250"
                                 Margin="0,12,0,0"
                                 HorizontalAlignment="Left"
                                 HorizontalContentAlignment="Center"
                                 IsReadOnly="True"
                                 FontSize="15"
                                 FontWeight="SemiBold"
                                 Cursor="Hand"
                                 GotKeyboardFocus="HotkeyTextBox_GotKeyboardFocus"
                                 LostKeyboardFocus="HotkeyTextBox_LostKeyboardFocus"
                                 PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                 ToolTip="点击后按下快捷键，至少包含 Ctrl、Alt、Shift 或 Win 中的一个。" />
                        <TextBlock x:Name="HotkeyStatusText"
                                   Margin="0,6,0,0"
                                   Foreground="#6EDC8C"
                                   Text="正在注册快捷键…" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="132"
                            Height="44"
                            Click="CaptureButton_Click"
                            Content="开始截图" />
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Margin="0,18,0,0"
                    Padding="22"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.ColumnSpan="2"
                               Margin="0,0,0,18"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="识别与翻译设置" />

                    <TextBlock Grid.Row="1"
                               VerticalAlignment="Center"
                               Text="OCR 语言" />
                    <ComboBox x:Name="OcrLanguageComboBox"
                              Grid.Row="1"
                              Grid.Column="1"
                              Margin="0,0,0,12"
                              SelectedValuePath="Code">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="White" Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="2"
                               VerticalAlignment="Center"
                               Text="目标语言" />
                    <ComboBox x:Name="TargetLanguageComboBox"
                              Grid.Row="2"
                              Grid.Column="1"
                              Margin="0,0,0,12"
                              SelectedValuePath="Code">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="White" Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="3"
                               VerticalAlignment="Center"
                               Text="翻译服务" />
                    <ComboBox x:Name="TranslationProviderComboBox"
                              Grid.Row="3"
                              Grid.Column="1"
                              Margin="0,0,0,12"
                              SelectionChanged="TranslationProviderComboBox_SelectionChanged">
                        <ComboBoxItem Tag="GoogleWeb" Content="Google 网页接口（实验性、无需 Key）" />
                        <ComboBoxItem Tag="OpenAI" Content="OpenAI 兼容接口" />
                    </ComboBox>

                    <StackPanel x:Name="OpenAiSettingsPanel"
                                Grid.Row="4"
                                Grid.ColumnSpan="2"
                                Visibility="Collapsed">
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="接口地址" />
                            <TextBox x:Name="OpenAiEndpointTextBox"
                                     Grid.Column="1"
                                     Margin="0,0,0,10"
                                     ToolTip="可填写 https://example.com/v1，应用会自动补全 /chat/completions" />
                            <TextBlock Grid.Row="1"
                                       VerticalAlignment="Center"
                                       Text="API Key" />
                            <PasswordBox x:Name="OpenAiApiKeyPasswordBox"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Margin="0,0,0,10" />
                            <TextBlock Grid.Row="2"
                                       VerticalAlignment="Center"
                                       Text="模型" />
                            <TextBox x:Name="OpenAiModelTextBox"
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     Margin="0,0,0,10" />
                            <TextBlock Grid.Row="3"
                                       Grid.Column="1"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Text="支持填写 /v1 基础地址或完整 Chat Completions 地址。API Key 使用 Windows 当前用户加密后保存在本机。" />
                            <StackPanel Grid.Row="4"
                                        Grid.Column="1"
                                        Margin="0,12,0,0"
                                        Orientation="Horizontal">
                                <Button x:Name="TestOpenAiButton"
                                        Click="TestOpenAiButton_Click"
                                        Content="测试连接" />
                                <TextBlock x:Name="OpenAiConnectionStatusText"
                                           MaxWidth="360"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Margin="0,18,0,0"
                    Padding="22"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="运行设置"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <CheckBox x:Name="StartWithWindowsCheckBox"
                                  Margin="0,14,0,0"
                                  Content="开机自动启动灵犀截图" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="启动后隐藏在系统托盘；关闭主窗口也不会退出，截图快捷键继续可用。" />
                        <TextBlock x:Name="StartupStatusText"
                                   Margin="0,6,0,0"
                                   Foreground="#6EDC8C" />
                    </StackPanel>
                    <Image Grid.Column="1"
                           Width="46"
                           Height="46"
                           Margin="20,0,2,0"
                           VerticalAlignment="Center"
                           Opacity="0.92"
                           Source="Assets/lingxi-icon.png"
                           Stretch="Uniform" />
                </Grid>
            </Border>

            <Grid Grid.Row="4" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Width="112"
                        HorizontalAlignment="Left"
                        Click="SaveSettingsButton_Click"
                        Content="保存设置" />
                <TextBlock x:Name="SettingsStatusText"
                           Grid.Column="1"
                           Margin="16,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2"
                        Width="96"
                        Margin="8,0,0,0"
                        Background="#394150"
                        Click="ExitApplicationButton_Click"
                        Content="退出程序"
                        ToolTip="完全退出灵犀截图；右上角关闭按钮会隐藏到系统托盘。" />
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
