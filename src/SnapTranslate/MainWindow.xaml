<Window x:Class="SnapTranslate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapTranslate"
        Height="660"
        Width="760"
        MinHeight="600"
        MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        Foreground="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="34">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="SnapTranslate"
                           FontSize="32"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="14"
                           Text="像聊天软件一样快速截图、标注、识别和翻译。" />
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,28,0,0"
                    Padding="22"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="截图快捷键"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="Ctrl + Shift + A · 截取鼠标所在显示器" />
                        <TextBlock x:Name="HotkeyStatusText"
                                   Margin="0,6,0,0"
                                   Foreground="#6EDC8C"
                                   Text="正在注册快捷键…" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="132"
                            Height="44"
                            Click="CaptureButton_Click"
                            Content="开始截图" />
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Margin="0,18,0,0"
                    Padding="22"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.ColumnSpan="2"
                               Margin="0,0,0,18"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="识别与翻译设置" />

                    <TextBlock Grid.Row="1"
                               VerticalAlignment="Center"
                               Text="OCR 语言" />
                    <ComboBox x:Name="OcrLanguageComboBox"
                              Grid.Row="1"
                              Grid.Column="1"
                              Margin="0,0,0,12"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Code" />

                    <TextBlock Grid.Row="2"
                               VerticalAlignment="Center"
                               Text="目标语言" />
                    <ComboBox x:Name="TargetLanguageComboBox"
                              Grid.Row="2"
                              Grid.Column="1"
                              Margin="0,0,0,12"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Code" />

                    <TextBlock Grid.Row="3"
                               VerticalAlignment="Center"
                               Text="翻译服务" />
                    <ComboBox x:Name="TranslationProviderComboBox"
                              Grid.Row="3"
                              Grid.Column="1"
                              Margin="0,0,0,12"
                              SelectionChanged="TranslationProviderComboBox_SelectionChanged">
                        <ComboBoxItem Tag="GoogleWeb" Content="Google 网页接口（实验性、无需 Key）" />
                        <ComboBoxItem Tag="OpenAI" Content="OpenAI 兼容接口" />
                    </ComboBox>

                    <StackPanel x:Name="OpenAiSettingsPanel"
                                Grid.Row="4"
                                Grid.ColumnSpan="2"
                                Visibility="Collapsed">
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="接口地址" />
                            <TextBox x:Name="OpenAiEndpointTextBox"
                                     Grid.Column="1"
                                     Margin="0,0,0,10" />
                            <TextBlock Grid.Row="1"
                                       VerticalAlignment="Center"
                                       Text="模型" />
                            <TextBox x:Name="OpenAiModelTextBox"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Margin="0,0,0,10" />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Text="API Key 从环境变量 SNAPTRANSLATE_API_KEY 读取，不会写入配置文件。" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,20,0,0">
                <Button Width="112"
                        HorizontalAlignment="Left"
                        Click="SaveSettingsButton_Click"
                        Content="保存设置" />
                <TextBlock x:Name="SettingsStatusText"
                           Margin="128,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" />
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
